{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPLOG" },
        { "path": "$APPLOG/**" },
        { "path": "$HOME/**" },
        { "path": "/run/media/**" },
        { "path": "/media/**" },
        { "path": "/mnt/**" }
      ]
    }
  ]
}
